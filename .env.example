# GEMINI_API_KEY: Injected at runtime via Google Cloud Secret Manager / AI Studio Secrets.
# Never commit real API keys or serviceAccountKey.json files to source control.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Cloud Run service URL injected at runtime.
APP_URL="MY_APP_URL"

# Optional comma-separated allowed origins for strict referrer/CORS checks in production.
# On Cloud Run, authenticate GCP workloads via Application Default Credentials (ADC) or
# Workload Identity Federation rather than static service account key files.
ALLOWED_ORIGINS="https://ais-dev-grzbiomzlv3dutcwf63ypg-650936582116.us-east1.run.app,https://ais-pre-grzbiomzlv3dutcwf63ypg-650936582116.us-east1.run.app"

