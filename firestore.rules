rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserPrivateProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSavedLunarSite(data, userId) {
      return data.keys().hasAll([
          'ownerId',
          'name',
          'latDeg',
          'lonDeg',
          'elevationM',
          'dateTimeUtc',
          'basemapMode',
          'notes',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId',
          'name',
          'latDeg',
          'lonDeg',
          'elevationM',
          'dateTimeUtc',
          'basemapMode',
          'notes',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 60
        && (data.latDeg is int || data.latDeg is float)
        && data.latDeg >= -90
        && data.latDeg <= 90
        && (data.lonDeg is int || data.lonDeg is float)
        && data.lonDeg >= -180
        && data.lonDeg <= 180
        && (data.elevationM is int || data.elevationM is float)
        && data.elevationM >= -12000
        && data.elevationM <= 20000
        && data.dateTimeUtc is string
        && data.dateTimeUtc.size() == 16
        && data.dateTimeUtc.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$')
        && data.basemapMode is string
        && data.basemapMode in ['wac', 'lola', 'hazard', 'quantized']
        && data.notes is string
        && data.notes.size() <= 400
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId}/private/profile {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserPrivateProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserPrivateProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'email',
          'displayName',
          'updatedAt'
        ]);
      allow delete: if isValidId(userId) && isOwner(userId);
    }

    match /users/{userId}/sites/{siteId} {
      allow get: if isValidId(userId)
        && isValidId(siteId)
        && isOwner(userId)
        && existing().ownerId == request.auth.uid;
      allow list: if isValidId(userId)
        && isOwner(userId)
        && existing().ownerId == request.auth.uid;
      allow create: if isValidId(userId)
        && isValidId(siteId)
        && isOwner(userId)
        && isValidSavedLunarSite(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isValidId(siteId)
        && isOwner(userId)
        && existing().ownerId == request.auth.uid
        && isValidSavedLunarSite(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'latDeg',
          'lonDeg',
          'elevationM',
          'dateTimeUtc',
          'basemapMode',
          'notes',
          'updatedAt'
        ]);
      allow delete: if isValidId(userId)
        && isValidId(siteId)
        && isOwner(userId)
        && existing().ownerId == request.auth.uid;
    }
  }
}
